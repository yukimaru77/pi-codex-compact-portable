{
  "name": "pi-codex-compact-portable",
  "version": "1.3.3-portable.0",
  "private": true,
  "description": "Codex Remote Compaction V2 for Pi, paired with KB-compatible plaintext extraction so compacted conversations work on any model.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "codex",
    "compaction",
    "openai"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "piExtension": {
    "lifecycle": "experimental"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run test:smoke",
    "format": "biome check --write --vcs-use-ignore-file=false src test package.json tsconfig.json README.md",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test:smoke": "node --import ./test/setup.mjs --import tsx test/sdk-smoke.mjs",
    "test": "node --import ./test/setup.mjs --import tsx --test test/*.test.ts",
    "lint": "biome check .",
    "test:core": "node --import tsx --test test/portable-core.test.ts"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.54.0",
    "@signalridge/pi-ui": "^1.3.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "26.1.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yukimaru77/pi-codex-compact-portable.git"
  },
  "homepage": "https://github.com/yukimaru77/pi-codex-compact-portable",
  "bugs": {
    "url": "https://github.com/yukimaru77/pi-codex-compact-portable/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
